# Copy to .env.local and fill in real values before running the app.
# This file is safe to commit; .env.local is ignored.

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL). Used by Prisma for migrations and the app client.
# Example for a local PostgreSQL instance:
DATABASE_URL="postgresql://user:password@localhost:5432/alquileres_anita?schema=public"
# Example for Neon / Supabase / Vercel Postgres (SSL usually required in production):
# DATABASE_URL="postgresql://user:password@host.region.provider.com/dbname?sslmode=require"
